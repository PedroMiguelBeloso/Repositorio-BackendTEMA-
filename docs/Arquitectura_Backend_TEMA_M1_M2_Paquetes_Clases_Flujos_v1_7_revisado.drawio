  <diagram id="02-identity" name="02 identity">
    <mxGraphModel dx="3180" dy="2934" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3180" pageHeight="2934" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="identity · subpaquetes, tipos y firmas mínimas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203044;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="65" y="35" width="3050" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Propuesta de implementación revisada. La capa application depende de puertos; infrastructure implementa esos puertos. Los DTO y firmas se cotejan con OpenAPI antes de codificar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203044;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
