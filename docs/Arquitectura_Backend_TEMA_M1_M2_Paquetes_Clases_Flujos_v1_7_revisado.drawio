        <mxCell id="c2" value="Flujos M1 + M2 · desde Flutter hasta persistencia y fuentes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203044;fontSize=29;fontStyle=1;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="70" y="30" width="3250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Cada fila es un flujo independiente. Las cajas muestran quién actúa y qué dato pasa; las excepciones relevantes quedan debajo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203044;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="70" y="94" width="3250" height="47" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;1 · Login y autorización&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontColor=#203044;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
