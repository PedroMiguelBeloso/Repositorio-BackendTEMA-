  <diagram id="01-shared" name="01 shared">
    <mxGraphModel dx="3180" dy="1784" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3180" pageHeight="1784" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="shared · subpaquetes, tipos y firmas mínimas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203044;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="65" y="35" width="3050" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Propuesta de implementación basada en arquitectura v1.5. Los DTO record generan un accesor por componente; sus campos deben cotejarse con OpenAPI antes de codificar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203044;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="65" y="99" width="3050" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;shared.api&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#3B6EAD;strokeWidth=2;fontSize=17;fontColor=#203044;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="65" y="195" width="650" height="955" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;ApiExceptionHandler&lt;/b&gt; &lt;font color='#687789'&gt;«@RestControllerAdvice»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;- problems: ProblemDetailsFactory&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ handleApiException(ex: ApiException): ResponseEntity&amp;lt;ProblemDetail&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Delegates application errors to ProblemDetailsFactory; Spring Boot handles built-in MVC errors.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="81" y="250" width="618" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;ProblemDetailsFactory&lt;/b&gt; &lt;font color='#687789'&gt;«component»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;- traceIdProvider: TraceIdProvider&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ forApiException(ex: ApiException): ProblemDetail&lt;br&gt;+ forSecurity(status: HttpStatus, code: ProblemCode, detail: String): ProblemDetail&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Adds optional code/traceId/details extensions to Spring ProblemDetail.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="81" y="435" width="618" height="212" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;PageMapper&lt;/b&gt; &lt;font color='#687789'&gt;«utility»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;&lt;i&gt;sin estado propio&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ toPageInfo(page: int, size: int, totalElements: long): PageInfo&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="81" y="662" width="618" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;shared.api.dto&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#3B6EAD;strokeWidth=2;fontSize=17;fontColor=#203044;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="743" y="195" width="650" height="955" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;PageInfo&lt;/b&gt; &lt;font color='#687789'&gt;«record / DTO»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;page: int&lt;br&gt;size: int&lt;br&gt;totalElements: long&lt;br&gt;totalPages: int&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ accessors(): uno por componente&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="759" y="250" width="618" height="191" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;PageResponse&amp;lt;T&amp;gt;&lt;/b&gt; &lt;font color='#687789'&gt;«record / DTO»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;items: List&amp;lt;T&amp;gt;&lt;br&gt;page: PageInfo&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ accessors(): uno por componente&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Use only when list JSON matches the OpenAPI.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="759" y="456" width="618" height="191" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;shared.application&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#3B6EAD;strokeWidth=2;fontSize=17;fontColor=#203044;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="1421" y="195" width="650" height="955" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;ProblemCode&lt;/b&gt; &lt;font color='#687789'&gt;«enum»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;VALIDATION_ERROR, INTERNAL_ERROR&lt;br&gt;NOT_FOUND, FORBIDDEN, UNAUTHORIZED&lt;br&gt;CONFLICT, STALE_REVISION&lt;br&gt;SOURCE_UNAVAILABLE, SOURCE_PERMISSION_DENIED&lt;br&gt;UNSUPPORTED_SCOPE, TICKET_SELECTION_INVALID&lt;br&gt;TICKET_OUTSIDE_PROJECT, RUN_NOT_COMPLETE&lt;br&gt;APPLICABILITY_NOT_PENDING&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ name(): String&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Optional code extension in OpenAPI ProblemDetail.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1437" y="250" width="618" height="296" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;FieldProblem&lt;/b&gt; &lt;font color='#687789'&gt;«record / DTO»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;field: String&lt;br&gt;message: String&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ accessors(): uno por componente&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Application value; serialized only when details extension is present.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1437" y="561" width="618" height="191" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;ApiException&lt;/b&gt; &lt;font color='#687789'&gt;«exception»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;- code: ProblemCode&lt;br&gt;- httpStatus: HttpStatus&lt;br&gt;- safeMessage: String&lt;br&gt;- details: List&amp;lt;FieldProblem&amp;gt;&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ ApiException(code: ProblemCode, status: HttpStatus, message: String, details: List&amp;lt;FieldProblem&amp;gt;)&lt;br&gt;+ code(): ProblemCode&lt;br&gt;+ httpStatus(): HttpStatus&lt;br&gt;+ safeMessage(): String&lt;br&gt;+ details(): List&amp;lt;FieldProblem&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Accessors match the agreed ProblemDetailsFactory API.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1437" y="767" width="618" height="338" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;shared.config&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#3B6EAD;strokeWidth=2;fontSize=17;fontColor=#203044;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="2099" y="195" width="650" height="955" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;CorsConfig&lt;/b&gt; &lt;font color='#687789'&gt;«@Configuration»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;- allowedOrigin: String&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ corsConfigurationSource(): UrlBasedCorsConfigurationSource&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Shared CORS bean; SecurityConfig enables it with cors().&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="2115" y="250" width="618" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;TimeConfig&lt;/b&gt; &lt;font color='#687789'&gt;«@Configuration»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;&lt;i&gt;sin estado propio&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ clock(): Clock&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;One Clock bean, not two Clock classes.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="2115" y="435" width="618" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;shared.infrastructure&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#3B6EAD;strokeWidth=2;fontSize=17;fontColor=#203044;align=left;verticalAlign=top;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="65" y="1193" width="650" height="476" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;TraceIdFilter&lt;/b&gt; &lt;font color='#687789'&gt;«OncePerRequestFilter»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;&lt;i&gt;sin estado propio&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ doFilterInternal(request: HttpServletRequest, response: HttpServletResponse, chain: FilterChain): void&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Creates/propagates traceId and clears MDC.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="81" y="1248" width="618" height="191" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;TraceIdProvider&lt;/b&gt; &lt;font color='#687789'&gt;«component»&lt;/font&gt;&lt;hr&gt;&lt;font color='#485466'&gt;&lt;i&gt;sin estado propio&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;font color='#1D5F64'&gt;+ currentTraceId(): String&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&lt;i&gt;Small adapter for shared error mapping.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6EAD;strokeWidth=1;fontColor=#203044;fontSize=12;align=left;verticalAlign=top;spacing=11;shadow=0;" vertex="1" parent="1">
